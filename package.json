{
  "name": "prx-wavefile",
  "version": "11.0.0-prx.5",
  "type": "module",
  "description": "Create, read and write wav files according to the specs.",
  "homepage": "https://github.com/PRX/prx-wavefile",
  "author": "Rafael da Silva Rocha <rocha.rafaelsilva@gmail.com>",
  "license": "MIT",
  "main": "./dist/wavefile.js",
  "module": "./index.js",
  "exports": {
    "import": "./dist/wrapper.mjs",
    "require": "./dist/wavefile.js"
  },
  "types": "./index.d.ts",
  "bin": "./bin/wavefile.js",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "wav",
    "RIFF",
    "RIFX",
    "RF64",
    "WAVE",
    "BWF",
    "audio",
    "8-bit",
    "11-bit",
    "12-bit",
    "16-bit",
    "20-bit",
    "24-bit",
    "32-bit",
    "64-bit",
    "PCM",
    "ADPCM",
    "encode",
    "decode",
    "A-Law",
    "mu-Law",
    "_PMX",
    "iXML",
    "cue",
    "resampler"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/PRX/prx-wavefile.git"
  },
  "bugs": {
    "url": "https://github.com/PRX/prx-wavefile/issues"
  },
  "directories": {
    "bin": "bin",
    "dist": "dist",
    "lib": "lib"
  },
  "files": [
    "bin",
    "dist",
    "lib",
    "index.js",
    "index.d.ts",
    "LICENSE",
    "README.md",
    "AUTHORS.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "lint": "jshint index.js bin lib test/src",
    "test": "c8 mocha test/resampler test/dist test/src test/wavefile-parser test/lib --recursive -R dot --timeout=1600000",
    "test-sr": "mocha test/resampler-full -R dot --timeout=1600000",
    "test-sr-point": "mocha test/resampler-full/point.js -R dot --timeout=1600000",
    "test-sr-linear": "mocha test/resampler-full/linear.js -R dot --timeout=1600000",
    "test-sr-cubic": "mocha test/resampler-full/cubic.js -R dot --timeout=1600000",
    "test-sr-sinc": "mocha test/resampler-full/sinc.js test/resampler-full/sinc-IIR.js test/resampler-full/sinc-no-lpf.js -R dot --timeout=1600000",
    "test-umd": "mocha test/resampler test/dist test/src --umd --recursive -R dot --timeout=240000",
    "test-tsc": "tsc --skipLibCheck ./test/TypeScript/index.ts && node ./test/TypeScript/index.js",
    "test-cli": "./bin/wavefile.js ./test/files/M1F1-int12WE-AFsp.wav --tag=ICMT && ./bin/wavefile.js ./test/files/M1F1-int12WE-AFsp.wav --resample=16000 --method=point ./test/files/out/to-sample-rate/M1F1-int12WE-AFsp-CLI.wav",
    "test-dist": "npm run test-umd && npm run test-tsc && npm run test-cli",
    "rollup-bundle": "rollup -c && npm run test-dist",
    "doc": "jsdoc -c .jsdocrc -d docs -r README.md -t node_modules/docdash",
    "build": "npm run lint && npm test && npm run rollup-bundle && npm run doc",
    "coverage": "c8 report --reporter=lcov"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^1.0.0",
    "byte-data": "^19.0.1",
    "c8": "^11.0.0",
    "docdash": "^1.1.1",
    "jsdoc": "^3.6.3",
    "jshint": "^2.10.3",
    "mocha": "^11.0.0",
    "rollup": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {}
}
